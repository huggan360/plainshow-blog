{
    "name": "plainshow/blog",
    "description": "PlainShow Blog: posts, galleries, stories and the Week of Bali trips.",
    "require": {
        "twig/twig": "^3.11",
        "plainshow/kit": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "Hugohansson\\Woc\\": "src/",
            "Blog\\": "app/src/"
        },
        "files": [
            "app/src/helpers.php"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/huggan360/plainshow-kit.git",
            "no-api": true
        }
    ],
    "config": {
        "preferred-install": {
            "plainshow/*": "source",
            "*": "dist"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php app/console.php publish-ui"
        ],
        "post-update-cmd": [
            "@php app/console.php publish-ui"
        ],
        "check-type": "check-type public/assets/blog"
    }
}
